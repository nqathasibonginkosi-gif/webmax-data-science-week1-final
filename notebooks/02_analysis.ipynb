import pandas as pd

df = pd.read_csv("data/clean/leads_clean.csv")
print("Total leads:", len(df))

# 1. Which source brings most value?
print(df.groupby("source").agg(leads=("lead_id","count"), total_value=("estimated_value_zar","sum")).sort_values("total_value", ascending=False))

# 2. Conversion Rate
converted = (df["status"] == "Converted").sum()
print(f"Converted: {converted} out of {len(df)}")
print(f"Conversion Rate: {converted/len(df)*100:.1f}%")

# 3. Status breakdown
print(df.groupby("status").agg(leads=("lead_id","count"), total_value=("estimated_value_zar","sum")))

# 4. Trend by month
df["lead_created_at"] = pd.to_datetime(df["lead_created_at"])
print(df.groupby(df["lead_created_at"].dt.to_period("M")).size()) 
